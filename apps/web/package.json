{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --dotenv .env.local",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:migrate": "kysely migrate latest",
    "db:migrate:generate": "kysely migrate latest && kysely-codegen --out-file ../../packages/shared/types.d.ts",
    "db:schema:dump": "PATH=\"$PWD/scripts:$PATH\" vite-node scripts/dump-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:e2e": "vitest --project e2e",
    "test:components": "vitest --project nuxt"
  },
  "dependencies": {
    "@monorepo/shared": "workspace:*",
    "@nuxt/content": "^3.13.0",
    "@tailwindcss/vite": "^4.2.4",
    "better-auth": "^1.6.9",
    "bullmq": "^5.76.5",
    "h3": "^1.15.4",
    "ioredis": "^5.10.1",
    "kysely": "^0.28.17",
    "magicast": "^0.5.2",
    "pg": "^8.20.0",
    "posthog-js": "^1.372.8",
    "radix-vue": "^1.9.17",
    "vue": "^3.5.28"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@base/testing": "workspace:*",
    "@iconify/json": "^2.2.469",
    "@nuxt/devtools": "^4.0.0-alpha.4",
    "@nuxt/image": "^2.0.0",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/seo": "^5.1.3",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@vue/test-utils": "^2.4.10",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "autoprefixer": "^10.5.0",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "happy-dom": "^20.9.0",
    "kysely-codegen": "^0.20.0",
    "kysely-ctl": "^0.20.0",
    "nuxt": "^4.4.4",
    "playwright-core": "^1.59.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "unimport": "^4.2.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.0.0",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.5",
    "vue-i18n": "^11.4.0",
    "ws": "^8.20.0"
  },
  "overrides": {
    "vue": "latest"
  }
}
