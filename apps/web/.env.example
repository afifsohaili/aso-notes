# ============================================================
# aso-notes environment — copy to apps/web/.env.local and fill in
# ============================================================

# --- Required ---

# PostgreSQL (Docker container from docker-compose.yml, port 5433)
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/aso_notes_development"
NUXT_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/aso_notes_development"

# Local folder to watch for notes (Markdown files). Absolute path.
NUXT_NOTES_DIR=/path/to/your/notes

# AI providers — each use (agent / extraction / embedding) has an independent
# quad: PROVIDER / BASE_URL / MODEL / API_KEY. Provider defaults to openrouter;
# base URL is optional (defaults: https://openrouter.ai/api/v1, http://localhost:11434).
# API_KEY is required for openrouter, ignored for ollama. Duplication is expected
# when several uses share a backend/key.
#
# Agent (chat conversation + tool calling):
NUXT_LLM_AGENT_PROVIDER=openrouter
NUXT_LLM_AGENT_API_KEY=
# NUXT_LLM_AGENT_BASE_URL=
# NUXT_LLM_AGENT_MODEL=deepseek/deepseek-v4-flash
#
# Extraction (ingestion-time concept/relation extraction):
NUXT_LLM_EXTRACTION_PROVIDER=openrouter
NUXT_LLM_EXTRACTION_API_KEY=
# NUXT_LLM_EXTRACTION_BASE_URL=
# NUXT_LLM_EXTRACTION_MODEL=deepseek/deepseek-v4-flash
#
# Embedding (keep on OpenRouter unless you also migrate the 2048-dim schema):
NUXT_LLM_EMBEDDING_PROVIDER=openrouter
NUXT_LLM_EMBEDDING_API_KEY=
# NUXT_LLM_EMBEDDING_BASE_URL=
# NUXT_LLM_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
#
# Example — local Ollama for agent + extraction, OpenRouter for embeddings:
# NUXT_LLM_AGENT_PROVIDER=ollama
# NUXT_LLM_AGENT_MODEL=gemma3:4b
# NUXT_LLM_EXTRACTION_PROVIDER=ollama
# NUXT_LLM_EXTRACTION_MODEL=gemma3:4b

# Auth session secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
NUXT_BETTER_AUTH_SECRET=

# Redis — ingestion queue + sweeper (Docker service on port 6379).
# Without it, synced notes stay `pending` and are never ingested.
NUXT_REDIS_URL=redis://127.0.0.1:6379

# --- Optional ---

# Models (any OpenRouter chat / embedding model ID; defaults shown)
# NUXT_OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
# NUXT_OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Email — in dev (NODE_ENV=development) email verification is bypassed,
# so nothing here is needed locally. For real email sending:
# NUXT_EMAIL_PROVIDER=brevo
# NUXT_BREVO_API_KEY=
# NUXT_SENDER_EMAIL=noreply@example.com
# NUXT_SENDER_NAME=aso-notes

# Turnstile (signup captcha) — skipped entirely in dev.
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET_KEY=

# PostHog analytics (optional)
# NUXT_PUBLIC_POSTHOG_API_KEY=
# NUXT_POSTHOG_API_KEY=

# Site URL (SEO / sitemap)
# NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_SENDER_EMAIL=noreply@example.com
NUXT_SENDER_NAME=No Reply

# Brevo (Email)
NUXT_BREVO_API_KEY=

# Email Provider (brevo, mailpit)
NUXT_EMAIL_PROVIDER=mailpit
